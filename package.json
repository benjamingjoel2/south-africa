{
  "name": "south-africa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/i18n-build.mjs && next dev",
    "build": "node scripts/i18n-build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "i18n": "node scripts/i18n-build.mjs",
    "i18n:extract": "node scripts/i18n-build.mjs extract",
    "i18n:missing": "node scripts/i18n-build.mjs missing",
    "cf-build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local && cp cloudflare/_headers cloudflare/_redirects .open-next/assets/",
    "preview": "npm run cf-build && opennextjs-cloudflare preview",
    "deploy": "npm run cf-build && opennextjs-cloudflare deploy",
    "cf-pages": "node scripts/cf-pages.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  }
}
